/storage/*
!/storage/.htaccess
!/storage/*/
/storage/*/*
!/storage/*/.gitkeep

# Referências originais (arquivos grandes, com dados de clientes — LGPD)
/referencias/*
!/referencias/LEIA-ME.md

# Sistema operacional / editores
.DS_Store
Thumbs.db
.idea/
.vscode/

